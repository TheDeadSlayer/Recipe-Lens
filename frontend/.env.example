# ── RecipeLens Frontend ────────────────────────────────────────────────────────
# Base URL for the RecipeLens API, as seen by the user's browser.
# In local development this is the FastAPI server on localhost.
# In production (Nginx same-origin proxy), set to an empty string "" or "/api/v1"
# so the browser uses a relative path and Nginx routes /api/* to the backend.
#
# Do NOT use http://backend:8000 — that hostname is only resolvable inside Docker,
# not by the user's browser.
VITE_API_BASE_URL=http://localhost:8000
