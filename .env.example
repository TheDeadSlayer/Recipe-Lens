# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_USER=recipelens
POSTGRES_PASSWORD=recipelens
POSTGRES_DB=recipelens

# ── Database URLs ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://recipelens:recipelens@postgres:5432/recipelens
TEST_DATABASE_URL=postgresql://recipelens:recipelens@postgres:5432/recipelens_test

# ── Providers ─────────────────────────────────────────────────────────────────
# transcript: mock | youtube
TRANSCRIPT_PROVIDER=mock

# llm: mock | openai
LLM_PROVIDER=mock

# ── OpenAI (only required when LLM_PROVIDER=openai) ──────────────────────────
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# ── Application ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Connection pool ───────────────────────────────────────────────────────────
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
