# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_USER=recipelens
POSTGRES_PASSWORD=recipelens
POSTGRES_DB=recipelens

# ── Database URLs ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://recipelens:recipelens@postgres:5432/recipelens
TEST_DATABASE_URL=postgresql://recipelens:recipelens@postgres:5432/recipelens_test

# ── Providers ─────────────────────────────────────────────────────────────────
# transcript: mock | youtube
TRANSCRIPT_PROVIDER=youtube

# llm: mock | openai | gemini
LLM_PROVIDER=gemini

# ── OpenAI (only required when LLM_PROVIDER=openai) ──────────────────────────
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# Timeout in seconds for each OpenAI chat completions call (default: 60)
# OPENAI_TIMEOUT_SECONDS=60

# Number of automatic retries on transient OpenAI errors (default: 2)
# OPENAI_MAX_RETRIES=2

# ── Gemini (only required when LLM_PROVIDER=gemini) ─────────────────────────
# When LLM_PROVIDER=gemini the pipeline bypasses transcript retrieval entirely.
# TRANSCRIPT_PROVIDER may remain configured but will not be called.
GEMINI_API_KEY=..
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_SECONDS=300

# ── Whisper audio fallback (used when TRANSCRIPT_PROVIDER=youtube and captions unavailable) ──
# Reuses OPENAI_API_KEY — no additional secret needed.
# WHISPER_MODEL=whisper-1

# Timeout in seconds for audio transcription calls (default: 300 — long videos take time)
# WHISPER_TIMEOUT_SECONDS=300

# ── Application ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Connection pool ───────────────────────────────────────────────────────────
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
