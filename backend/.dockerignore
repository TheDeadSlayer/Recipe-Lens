# Python bytecode
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

# Virtual environments
.venv/
venv/
env/

# Local env files — never copy secrets into the image
.env
.env.*

# Test artefacts
.pytest_cache/
.coverage
htmlcov/
coverage.xml
tests/

# Dev/CI scripts (init-test-db.sql etc. have no place in a production image)
scripts/

# Build artefacts
*.egg-info/
dist/
build/

# Documentation and plan files
*.md

# Git metadata
.git/
.gitignore

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db
